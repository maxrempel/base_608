# Per-family cap in KiB/s. Two families run at once.
# Policy per Max 2026-08-06 (home line 500 Mbps): daytime (07:00-23:00) total <=250 Mbps,
# nighttime (23:00-07:00) total <=350 Mbps. Split over 2 concurrent families:
#   15000 KiB/s per family day (~15 MB/s x2 = 30 MB/s ~ 250 Mbps)
#   21000 KiB/s per family night (~21 MB/s x2 = 42 MB/s ~ 350 Mbps)
# The run_downloader_v01.sh wrapper picks the cap by the hour; this file only overrides.
RATE_KBPS=15000
